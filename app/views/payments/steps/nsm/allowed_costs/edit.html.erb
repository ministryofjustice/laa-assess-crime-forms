<% local_prefix = @to_be_paid ? '.to_be_paid_overrides' : nil %>
<% title t("#{local_prefix}.page_title") %>

<% step_header(path: previous_decision_step_path) %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= govuk_error_summary(@form_object) %>
    <h1 class="govuk-heading-xl">
      <%= t("#{local_prefix}.heading") %>
    </h1>
    <% if @to_be_paid %>
      <p class="govuk-body">
        <%= t("#{local_prefix}.additional_text") %>
      </p>
    <% end %>
  </div>
</div>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds" id="payments-calculate-container">
    <%= step_form @form_object do |f| %>
      <div class="govuk-form-group">
        <%= f.govuk_text_field :allowed_profit_cost,
          id: "profit_costs",
          prefix_text: "£",
          inputmode: "decimal",
          label: { for: 'profit_costs', size: 's', text: t('.profit_costs') },
          width: 10 %>
      </div>
      <div class="govuk-form-group">
        <%= f.govuk_text_field :allowed_disbursement_cost,
          id: "disbursement_costs",
          prefix_text: "£",
          inputmode: "decimal",
          label: { for: 'disbursement_costs', size: 's', text: t('.disbursement_costs') },
          width: 10 %>
      </div>
      <div class="govuk-form-group">
        <%= f.govuk_text_field :allowed_travel_cost,
          id: "travel_costs",
          prefix_text: "£",
          inputmode: "decimal",
          label: { for: 'travel_costs', size: 's', text: t('.travel_costs') },
          width: 10 %>
      </div>
      <div class="govuk-form-group">
        <%= f.govuk_text_field :allowed_waiting_cost,
          id: "waiting_costs",
          prefix_text: "£",
          inputmode: "decimal",
          label: { for: 'waiting_costs', size: 's' , text: t('.waiting_costs') },
          width: 10 %>
      </div>

      <div class="govuk-form-group">
      <%= govuk_button_link_to(t('.calculate_cost'), '#',
        secondary: true ,
        id: 'payments_calculate_change_button'
      ) %>
      </div>

      <div class="govuk-heading-l">
        <h2 class="govuk-caption-m"><%= t('.total_cost') %></h2>
        <span id="total_cost"><%= LaaCrimeFormsCommon::NumberTo.pounds(@form_object.allowed_total) %></span>
      </div>

      <%= f.continue_button(primary: :continue_button, secondary: false,  primary_opts: { id: 'costs_submit_button'}) %>
    <% end %>
  </div>
</div>

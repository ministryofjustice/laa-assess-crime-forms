<% title t('.page_title') %>

<% step_header(path: previous_decision_step_path) %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= govuk_error_summary(@form_object) %>
    <h1 class="govuk-heading-xl">
      <%= t('.heading') %>
    </h1>
  </div>
</div>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds" id="payments-calculate-container">
    <%= step_form @form_object do |f| %>
      <div class="govuk-form-group">
        <%= f.govuk_text_field :claimed_net_assigned_counsel_cost,
          id: "counsel_costs_net",
          prefix_text: "£",
          inputmode: "decimal",
          label: { for: 'counsel_costs_net', size: 's', text: t('.claimed_net_assigned_counsel_cost') },
          width: 10 %>
      </div>
      <div class="govuk-form-group">
        <%= f.govuk_text_field :claimed_assigned_counsel_vat,
          id: "counsel_costs_vat",
          prefix_text: "£",
          inputmode: "decimal",
          label: { for: 'counsel_costs_vat', size: 's', text: t('.claimed_assigned_counsel_vat') },
          width: 10 %>
      </div>

      <div class="govuk-form-group">
        <%= govuk_button_link_to(t('.calculate_cost'), '#',
          secondary: true ,
          id: 'payments_calculate_change_button'
        ) %>
      </div>

      <div class="govuk-heading-l">
        <h2 class="govuk-caption-m"><%= t('.total_cost') %></h2>
        <span id="total_cost"><%= "#{LaaCrimeFormsCommon::NumberTo.pounds(@form_object.claimed_total)}" %></span>
      </div>

      <%= f.continue_button(primary: :continue_button, secondary: false, primary_opts: { id: 'costs_submit_button'}) %>
    <% end %>
  </div>
</div>

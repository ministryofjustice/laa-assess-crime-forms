<% title t('.page_title') %>
<div class="moj-page-header-actions">
    <div class="moj-page-header-actions__title">
        <h1 class="govuk-heading-xl">
            <%= t('.page_title') %>
        </h1>
    </div>

    <% if role_management_editable %>
        <div class="moj-page-header-actions__actions">
            <div class="moj-button-group moj-button-group--inline">
                <%= govuk_button_link_to(
                    t(".add_new_user"),
                    new_user_path,
                    secondary: true
                ) %>
            </div>
        </div>
    <% end %>
</div>

<% unless role_management_editable %>
    <%= govuk_inset_text(text: t('.read_only_external_roles', source: role_management_source)) %>
<% end %>

<table class="govuk-table" data-module="moj-sortable-table" aria-describedby="page-title">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <%= table_header_with_form("name",
                                       "users.index.table",
                                       0,
                                       users_path,
                                       @sort_by,
                                       @sort_direction) %>


            <%= table_header_with_form("email",
                                       "users.index.table",
                                       1,
                                       users_path,
                                       @sort_by,
                                       @sort_direction) %>


            <%= table_header_with_form("role",
                                       "users.index.table",
                                       2,
                                       users_path,
                                       @sort_by,
                                       @sort_direction) %>

            <%= table_header_with_form("service",
                                       "users.index.table",
                                       3,
                                       users_path,
                                       @sort_by,
                                       @sort_direction) %>
        </tr>
    </thead>

    <tbody class="govuk-table__body app-task-list__items">
        <% users.each do |user| %>
            <% roles = user.roles %>
            <tr class="govuk-table__row app-task-list__item">
                <td class="govuk-table__cell">
                    <% if role_management_editable %>
                        <%= govuk_link_to(user.display_name, edit_user_path(user.id)) %>
                    <% else %>
                        <%= user.display_name %>
                    <% end %>
                </td>
                <td class="govuk-table__cell">
                    <%= user.email %>
                </td>
                <td class="govuk-table__cell">
                    <% if user.deactivated_at.present? %>
                        <%= t('.user_disabled') %>
                    <% elsif roles.any? %>
                        <%= roles.map { _1.role_type.capitalize }.join(', ') %>
                    <% else %>
                        <%= t('.no_role') %>
                    <% end %>
                </td>
                <td class="govuk-table__cell">
                    <% if roles.any? && user.deactivated_at.nil? %>
                        <%= roles.map { |role| role.service == 'all' ? role.service.capitalize : role.service.upcase }.join(', ') %>
                    <% else %>
                        -
                    <% end %>
                </td>
            </tr>
        <% end %>
    </tbody>
</table>
<%= render 'shared/pagination', pagy: pagy, item: t(".users") %>
